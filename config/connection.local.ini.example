# Copy this file to connection.local.ini in the same directory, then fill in
# both values once. run_windows.bat and the EXE load it automatically.
# The real connection.local.ini is ignored by Git and excluded from releases.
# UTF-8 text; values are literal (no quotes or inline comments).
[credentials]
password=
auth_code=

[risk]
# Required for live orders and risk screenshots. Must exactly match the filed value.
daily_max_order_count=
# Exact filed per-second peak; rolling 1000ms. This is a separate threshold.
per_second_max_order_count=
